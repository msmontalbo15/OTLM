const sb = {
  _token: null as string | null,
  _user:  null as SupabaseUser | null,
  _refreshToken: null as string | null,

  _h(extra: Record<string, string> = {}): Record<string, string> {
    return {
      "Content-Type": "application/json",
      apikey: SB_KEY,
      Authorization: `Bearer ${this._token ?? SB_KEY}`,
      Prefer: "return=representation",
      ...extra,
    };
  },

  _save(): void {
    if (!this._token) return;
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({
        token: this._token,
        refresh: this._refreshToken,
        user: this._user,
        exp: Date.now() + 3_600_000,
      }));
    } catch (_) { /* ignore */ }
  },

  _clear(): void {
    this._token = null; this._user = null; this._refreshToken = null;
    try { localStorage.removeItem(STORAGE_KEY); } catch (_) { /* ignore */ }
  },

  restore(): boolean {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return false;
      const s = JSON.parse(raw) as { token: string; refresh: string; user: SupabaseUser; exp: number };
      if (Date.now() > s.exp) { this._clear(); return false; }
      this._token = s.token;
      this._user  = s.user;
      this._refreshToken = s.refresh;
      return true;
    } catch (_) { return false; }
  },

  async refresh(): Promise<boolean> {
    if (!this._refreshToken) return false;
    try {
      const r = await fetch(`${SB_URL}/auth/v1/token?grant_type=refresh_token`, {
        method: "POST", headers: this._h(),
        body: JSON.stringify({ refresh_token: this._refreshToken }),
      });
      const d = await r.json() as { access_token?: string; refresh_token?: string; user?: SupabaseUser };
      if (d.access_token) {
        this._token = d.access_token;
        this._refreshToken = d.refresh_token ?? this._refreshToken;
        this._user  = d.user ?? this._user;
        this._save();
        return true;
      }
    } catch (_) { /* ignore */ }
    return false;
  },

  async signUp(email: string, password: string): Promise<Record<string, unknown>> {
    const r = await fetch(`${SB_URL}/auth/v1/signup`, {
      method: "POST", headers: this._h(),
      body: JSON.stringify({ email, password }),
    });
    const d = await r.json() as Record<string, unknown>;
    if (d.access_token) {
      this._token = d.access_token as string;
      this._refreshToken = (d.refresh_token as string) ?? null;
      this._user  = d.user as SupabaseUser;
      this._save();
    }
    return d;
  },

  async signIn(email: string, password: string): Promise<Record<string, unknown>> {
    const r = await fetch(`${SB_URL}/auth/v1/token?grant_type=password`, {
      method: "POST", headers: this._h(),
      body: JSON.stringify({ email, password }),
    });
    const d = await r.json() as Record<string, unknown>;
    if (d.access_token) {
      this._token = d.access_token as string;
      this._refreshToken = (d.refresh_token as string) ?? null;
      this._user  = d.user as SupabaseUser;
      this._save();
    }
    return d;
  },

  async signOut(): Promise<void> {
    try { await fetch(`${SB_URL}/auth/v1/logout`, { method: "POST", headers: this._h() }); } catch (_) { /* ignore */ }
    this._clear();
  },

  async select<T = unknown>(table: string, qs = ""): Promise<T[]> {
    const r = await fetch(`${SB_URL}/rest/v1/${table}?${qs}`, { headers: this._h() });
    if (!r.ok) { if (r.status === 401) await this.refresh(); return []; }
    return r.json() as Promise<T[]>;
  },

  async insert<T = unknown>(table: string, data: Record<string, unknown>): Promise<T[]> {
    const r = await fetch(`${SB_URL}/rest/v1/${table}`, {
      method: "POST", headers: this._h(),
      body: JSON.stringify(data),
    });
    if (!r.ok) { const e = await r.json() as { message?: string }; throw new Error(e.message ?? "Insert failed"); }
    return r.json() as Promise<T[]>;
  },

  async update<T = unknown>(table: string, data: Record<string, unknown>, match: Record<string, string | number | boolean>): Promise<T[]> {
    const q = Object.entries(match).map(([k, v]) => `${k}=eq.${encodeURIComponent(String(v))}`).join("&");
    const r = await fetch(`${SB_URL}/rest/v1/${table}?${q}`, {
      method: "PATCH", headers: this._h(),
      body: JSON.stringify(data),
    });
    if (!r.ok) { const e = await r.json() as { message?: string }; throw new Error(e.message ?? "Update failed"); }
    return r.json() as Promise<T[]>;
  },

  async del(table: string, match: Record<string, string | number | boolean>): Promise<boolean> {
    const q = Object.entries(match).map(([k, v]) => `${k}=eq.${encodeURIComponent(String(v))}`).join("&");
    const r = await fetch(`${SB_URL}/rest/v1/${table}?${q}`, { method: "DELETE", headers: this._h() });
    return r.ok;
  },
};

