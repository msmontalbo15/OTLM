// ─── VALIDATE PAGE ────────────────────────────────────────────────────────────
function ValidatePage() {
  const [key, setKey]       = useState("");
  const [domain, setDomain] = useState("");
  const [ip, setIp]         = useState("");
  const [fw, setFw]         = useState("");
  const [result, setResult] = useState<ValidationResult | null>(null);
  const [loading, setL]     = useState(false);

  const validate = async () => {
    setL(true); setResult(null);
    const rows = await sb.select<License>("lh_licenses", `key=eq.${encodeURIComponent(key.trim().toUpperCase())}`);
    const lic  = rows[0] ?? null;
    let res: string = "invalid";
    let reason: string | null = "License key not found.";
    if (lic) {
      if (lic.status === "suspended")                                                                                                                             { res = "suspended";      reason = "License suspended."; }
      else if (lic.status === "expired" || isExpired(lic.expires_at))                                                                                           { res = "expired";        reason = "License expired."; }
      else if (lic.max_activations > 0 && lic.activations >= lic.max_activations)                                                                               { res = "quota_exceeded"; reason = "Quota exceeded."; }
      else if (domain && lic.allowed_domains?.length && !lic.allowed_domains.includes(domain.replace(/^https?:\/\//, "").split("/")[0])) { res = "domain_mismatch"; reason = `Domain not allowed. Permitted: ${lic.allowed_domains.join(", ")}`; }
      else if (ip && lic.allowed_ips?.length && !lic.allowed_ips.includes(ip))                                                                                  { res = "invalid";        reason = `IP ${ip} not in allowed list.`; }
      else { res = "valid"; reason = null; }
    }
    await sb.insert("lh_validation_logs", { license_id: lic?.id ?? null, license_key: key.trim().toUpperCase(), domain: domain || null, ip_address: ip || null, framework: fw || null, result: res });
    setResult({ valid: res === "valid", result: res, reason, license: lic });
    setL(false);
  };

  return (
    <div style={{ maxWidth: 540 }}>
      <div className="card" style={{ marginBottom: 14 }}>
        <div style={{ fontWeight: 600, fontSize: 13.5, marginBottom: 3 }}>Test License Validation</div>
        <div style={{ fontSize: 12, color: "var(--mu)", marginBottom: 16 }}>Simulates a real SDK call — result logged to <code style={{ fontFamily: "var(--mono)", fontSize: 11 }}>lh_validation_logs</code>.</div>
        <div className="fg"><label>License Key *</label><input placeholder="XXXXX-XXXXX-XXXXX-XXXXX" value={key} onChange={e => setKey(e.target.value)} style={{ fontFamily: "var(--mono)", letterSpacing: ".05em" }} /></div>
        <div className="fr">
          <div className="fg"><label>Domain</label><input placeholder="yourdomain.com" value={domain} onChange={e => setDomain(e.target.value)} /></div>
          <div className="fg"><label>IP Address</label><input placeholder="1.2.3.4" value={ip} onChange={e => setIp(e.target.value)} /></div>
        </div>
        <div className="fg"><label>Framework</label><select value={fw} onChange={e => setFw(e.target.value)}><option value="">Not specified</option>{FRAMEWORKS.map(f => <option key={f.id} value={f.id}>{f.icon} {f.name}</option>)}</select></div>
        <button className="btn btn-primary" onClick={() => void validate()} disabled={!key.trim() || loading} style={{ width: "100%", justifyContent: "center", padding: "9px" }}>{loading ? <><Spin /> Validating…</> : "Validate License"}</button>
      </div>
      {result && (
        <div className={`alert ${result.valid ? "a-ok" : "a-err"}`}>
          <span>{result.valid ? "✅" : "❌"}</span>
          <div>
            <strong>{result.valid ? "Valid License" : `Rejected: ${result.result.replace("_", " ")}`}</strong>
            {!result.valid && <><br /><span style={{ fontSize: 11.5 }}>{result.reason}</span></>}
            {result.valid && result.license && <div style={{ fontSize: 11.5, marginTop: 3 }}>Customer: {result.license.customer_name ?? "—"} · Expires: {result.license.expires_at ? fmt(result.license.expires_at) : "Never"} · Activations: {result.license.activations}/{result.license.max_activations}</div>}
          </div>
        </div>
      )}
    </div>
  );
}

// ─── ANALYTICS ────────────────────────────────────────────────────────────────
function AnalyticsPage({ logs }: { logs: ValidationLog[] }) {
  const byDay: Record<string, DayCount> = {};
  logs.forEach(l => {
    const d = new Date(l.created_at).toLocaleDateString("en-US", { month: "short", day: "numeric" });
    if (!byDay[d]) byDay[d] = { v: 0, i: 0 };
    if (l.result === "valid") byDay[d]!.v++; else byDay[d]!.i++;
  });
  const days   = Object.entries(byDay).slice(-7).reverse();
  const byRes: Record<string, number> = {};
  logs.forEach(l => { byRes[l.result] = (byRes[l.result] ?? 0) + 1; });
  const totalV = logs.filter(l => l.result === "valid").length;
  const totalI = logs.length - totalV;
  const rate   = logs.length ? Math.round((totalV / logs.length) * 100) : 0;

  return (
    <>
      <div className="stat-grid" style={{ gridTemplateColumns: "repeat(3,1fr)" }}>
        <div className="stat-card c1"><div className="stat-ico">📊</div><div className="stat-lbl">Total Validations</div><div className="stat-val">{logs.length}</div></div>
        <div className="stat-card c2"><div className="stat-ico">✅</div><div className="stat-lbl">Success Rate</div><div className="stat-val">{rate}%</div><div className="stat-delta">{totalV} valid · {totalI} rejected</div></div>
        <div className="stat-card c3"><div className="stat-ico">⚠️</div><div className="stat-lbl">Rejection Types</div><div className="stat-val">{Object.keys(byRes).filter(r => r !== "valid").length}</div></div>
      </div>
      <div className="grid2">
        <div className="card">
          <div style={{ fontWeight: 600, fontSize: 13, marginBottom: 13 }}>Last 7 Days</div>
          {days.length === 0 ? <div style={{ color: "var(--mu)", fontSize: 12 }}>No data yet.</div> : days.map(([day, c]) => (
            <div key={day} style={{ marginBottom: 11 }}>
              <div style={{ display: "flex", justifyContent: "space-between", fontSize: 11.5, marginBottom: 3 }}>
                <span>{day}</span>
                <span style={{ color: "var(--mu)" }}>{c.v + c.i} · <span style={{ color: "var(--grn)" }}>{c.v}✓</span> · <span style={{ color: "var(--red)" }}>{c.i}✗</span></span>
              </div>
              <div style={{ display: "flex", gap: 2 }}>
                {c.v > 0 && <div className="prog" style={{ flex: c.v }}><div className="prog-fill" style={{ width: "100%", background: "var(--grn)" }} /></div>}
                {c.i > 0 && <div className="prog" style={{ flex: c.i }}><div className="prog-fill" style={{ width: "100%", background: "var(--red)" }} /></div>}
              </div>
            </div>
          ))}
        </div>
        <div className="card">
          <div style={{ fontWeight: 600, fontSize: 13, marginBottom: 13 }}>Rejections</div>
          {Object.entries(byRes).filter(([r]) => r !== "valid").length === 0
            ? <div style={{ color: "var(--mu)", fontSize: 12 }}>No rejections.</div>
            : Object.entries(byRes).filter(([r]) => r !== "valid").sort((a, b) => b[1] - a[1]).map(([r, c]) => (
              <div key={r} style={{ marginBottom: 11 }}>
                <div style={{ display: "flex", justifyContent: "space-between", fontSize: 11.5, marginBottom: 3 }}><span style={{ textTransform: "capitalize" }}>{r.replace("_", " ")}</span><span style={{ color: "var(--mu)" }}>{c}</span></div>
                <div className="prog"><div className="prog-fill" style={{ width: totalI ? `${(c / totalI) * 100}%` : "0%", background: "var(--red)" }} /></div>
              </div>
            ))
          }
          <div className="divider" />
          <div style={{ fontWeight: 600, fontSize: 13, marginBottom: 10 }}>Recent Logs</div>
          <div style={{ maxHeight: 190, overflowY: "auto" }}>
            {[...logs].sort((a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime()).slice(0, 30).map(l => (
              <div key={l.id} style={{ display: "flex", justifyContent: "space-between", padding: "4px 0", borderBottom: "1px solid rgba(37,40,64,.4)", fontSize: 10.5 }}>
                <span style={{ fontFamily: "var(--mono)", color: "var(--mu)" }}>{l.license_key.substring(0, 14)}…</span>
                <span style={{ color: l.result === "valid" ? "var(--grn)" : "var(--red)", textTransform: "capitalize" }}>{l.result}</span>
                <span style={{ color: "var(--mu)" }}>{new Date(l.created_at).toLocaleTimeString()}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </>
  );
}

