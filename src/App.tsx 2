    : lic.allowed_domains?.length && !lic.allowed_domains.includes(domain) ? "domain_mismatch"
    : "valid";
  await fetch(\`\${SB}/rest/v1/lh_validation_logs\`, {
    method: "POST", headers: H,
    body: JSON.stringify({ license_id: lic?.id, license_key: LIC, domain, framework, result }),
  });
  return { valid: result === "valid", result };
}`} />
    </div>
  );
}

