@keyframes appear{from{opacity:0;transform:translateX(-4px)}to{opacity:1;transform:none}}
`;

// ─── SMALL COMPONENTS ─────────────────────────────────────────────────────────
function Code({ lang, code }: { lang: string; code: string }) {
  const [copied, setCopied] = useState(false);
  return (
    <div className="code-wrap">
      <div className="code-hdr">
        <span className="code-lang">{lang}</span>
        <button className="copy-btn" onClick={() => { void navigator.clipboard.writeText(code); setCopied(true); setTimeout(() => setCopied(false), 1800); }}>{copied ? "✓ copied" : "copy"}</button>
      </div>
      <pre>{code}</pre>
    </div>
  );
}

function Badge({ status }: { status: string }) {
  return <span className={`badge b-${status}`}><span>●</span>{status}</span>;
}

function Spin() { return <span className="spinner" />; }

function Modal({ onClose, children, lg = false, xl = false }: { onClose: () => void; children: ReactNode; lg?: boolean; xl?: boolean }) {
  return (
    <div className="overlay" onClick={onClose}>
      <div className={`modal ${lg ? "modal-lg" : xl ? "modal-xl" : ""}`} onClick={e => e.stopPropagation()}>{children}</div>
    </div>
  );
}

// ─── AUTH ─────────────────────────────────────────────────────────────────────
function AuthPage({ onAuth }: { onAuth: (u: SupabaseUser) => void }) {
  const [mode, setMode] = useState<"signin" | "signup">("signin");
  const [email, setEmail] = useState("");
  const [pass, setPass]   = useState("");
  const [err, setErr]     = useState("");
  const [loading, setL]   = useState(false);
  const [done, setDone]   = useState(false);

  const submit = async () => {
    if (!email || !pass) return setErr("Email and password required.");
    setL(true); setErr("");
    const d = mode === "signup" ? await sb.signUp(email, pass) : await sb.signIn(email, pass);
    if (d.error || d.error_description) setErr((d.error_description ?? (d.error as { message?: string })?.message ?? "Auth failed.") as string);
    else if (mode === "signup") setDone(true);
    else onAuth((d.user ?? sb._user) as SupabaseUser);
    setL(false);
  };

  if (done) return (
    <div className="auth-wrap">
      <div className="auth-card" style={{ textAlign: "center" }}>
        <div style={{ fontSize: 42, marginBottom: 14 }}>📬</div>
        <div className="auth-title">Confirm your email</div>
        <div className="auth-sub">Sent to <strong>{email}</strong>. Click the link then sign in.</div>
        <button className="btn btn-ghost" style={{ width: "100%", justifyContent: "center" }} onClick={() => { setMode("signin"); setDone(false); }}>Back to Sign In</button>
      </div>
    </div>
  );

  return (
    <div className="auth-wrap">
      <div className="auth-card">
        <div className="auth-logo"><div className="logo-glyph">🔐</div><div><div className="logo-name">LicenseHub</div><div className="logo-tag">License Manager SaaS</div></div></div>
        <div className="auth-title">{mode === "signin" ? "Welcome back" : "Create account"}</div>
        <div className="auth-sub">{mode === "signin" ? "Sign in to manage your licenses." : "Start in minutes."}</div>
        {err && <div className="alert a-err" style={{ marginBottom: 14 }}><span>⚠️</span>{err}</div>}
        <div className="fg"><label>Email</label><input type="email" placeholder="you@example.com" value={email} onChange={e => setEmail(e.target.value)} onKeyDown={e => e.key === "Enter" && void submit()} /></div>
        <div className="fg"><label>Password</label><input type="password" placeholder="••••••••" value={pass} onChange={e => setPass(e.target.value)} onKeyDown={e => e.key === "Enter" && void submit()} /></div>
        <button className="btn btn-primary" style={{ width: "100%", justifyContent: "center", padding: "9px" }} onClick={() => void submit()} disabled={loading}>{loading ? <Spin /> : mode === "signin" ? "Sign In" : "Create Account"}</button>
        <div className="auth-switch">{mode === "signin" ? <>No account? <button onClick={() => { setMode("signup"); setErr(""); }}>Sign up</button></> : <>Have an account? <button onClick={() => { setMode("signin"); setErr(""); }}>Sign in</button></>}</div>
      </div>
    </div>
  );
}

// ─── DASHBOARD ────────────────────────────────────────────────────────────────
function Dashboard({ licenses, logs }: { licenses: License[]; logs: ValidationLog[] }) {
  const active  = licenses.filter(l => l.status === "active").length;
  const expired = licenses.filter(l => l.status === "expired" || isExpired(l.expires_at)).length;
  const trial   = licenses.filter(l => l.status === "trial").length;
  const today   = logs.filter(l => new Date(l.created_at).toDateString() === new Date().toDateString());
  const totalV  = today.filter(l => l.result === "valid").length;

  const byFw: Record<string, number> = {};
  logs.forEach(l => { if (l.framework) byFw[l.framework] = (byFw[l.framework] ?? 0) + 1; });
  const fwList = Object.entries(byFw).sort((a, b) => b[1] - a[1]).slice(0, 5);
  const recent = [...logs].sort((a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime()).slice(0, 7);

  return (
    <>
      <div className="stat-grid">
        <div className="stat-card c1"><div className="stat-ico">🔑</div><div className="stat-lbl">Total Licenses</div><div className="stat-val">{licenses.length}</div><div className="stat-delta">All time</div></div>
        <div className="stat-card c2"><div className="stat-ico">✅</div><div className="stat-lbl">Active</div><div className="stat-val">{active}</div><div className="stat-delta">{trial} on trial</div></div>
        <div className="stat-card c3"><div className="stat-ico">⏳</div><div className="stat-lbl">Expired</div><div className="stat-val">{expired}</div><div className={`stat-delta ${expired > 0 ? "bad" : ""}`}>{expired > 0 ? "Action needed" : "All clear"}</div></div>
        <div className="stat-card c4"><div className="stat-ico">📡</div><div className="stat-lbl">Validations Today</div><div className="stat-val">{today.length}</div><div className="stat-delta">{totalV} valid · {today.length - totalV} rejected</div></div>
      </div>
      <div className="grid2">
        <div className="card">
          <div style={{ fontWeight: 600, fontSize: 13, marginBottom: 13 }}>Recent Events</div>
          {recent.length === 0 ? <div style={{ color: "var(--mu)", fontSize: 12 }}>No events yet.</div> :
            recent.map((l, i) => (
              <div key={l.id} style={{ display: "flex", justifyContent: "space-between", alignItems: "center", padding: "7px 0", borderBottom: i < recent.length - 1 ? "1px solid rgba(37,40,64,.5)" : "none" }}>
                <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
                  <span>{l.result === "valid" ? "✅" : "❌"}</span>
                  <div>
                    <div style={{ fontSize: 12, fontWeight: 500, textTransform: "capitalize" }}>{l.result.replace("_", " ")}</div>
                    <div style={{ fontSize: 10.5, color: "var(--mu)" }}>{l.domain ?? "unknown"}{l.framework ? ` · ${l.framework}` : ""}</div>
                  </div>
                </div>
                <div style={{ fontSize: 10, color: "var(--mu)" }}>{new Date(l.created_at).toLocaleTimeString()}</div>
              </div>
            ))
          }
        </div>
        <div className="card">
          <div style={{ fontWeight: 600, fontSize: 13, marginBottom: 13 }}>Top Frameworks</div>
          {fwList.length === 0 ? <div style={{ color: "var(--mu)", fontSize: 12 }}>No framework data yet.</div> :
            fwList.map(([fw, count]) => {
              const f = FRAMEWORKS.find(x => x.id === fw);
              return (
                <div key={fw} style={{ marginBottom: 11 }}>
                  <div style={{ display: "flex", justifyContent: "space-between", fontSize: 12, marginBottom: 3 }}>
                    <span>{f?.icon ?? "⚙"} {f?.name ?? fw}</span>
                    <span style={{ color: "var(--mu)" }}>{count}</span>
                  </div>
                  <div className="prog"><div className="prog-fill" style={{ width: `${(count / (fwList[0][1] as number)) * 100}%`, background: "var(--a)" }} /></div>
                </div>
              );
            })
          }
          <div className="divider" />
          <div style={{ fontWeight: 600, fontSize: 13, marginBottom: 11 }}>Distribution</div>
          {[
            { l: "Active",    v: active,  c: "var(--grn)" },
            { l: "Trial",     v: trial,   c: "var(--a3)" },
            { l: "Expired",   v: expired, c: "var(--red)" },
            { l: "Suspended", v: licenses.filter(x => x.status === "suspended").length, c: "var(--mu)" },
          ].map(p => (
            <div key={p.l} style={{ marginBottom: 9 }}>
              <div style={{ display: "flex", justifyContent: "space-between", fontSize: 11.5, marginBottom: 3 }}><span>{p.l}</span><span style={{ color: "var(--mu)" }}>{p.v}</span></div>
              <div className="prog"><div className="prog-fill" style={{ width: licenses.length ? `${(p.v / licenses.length) * 100}%` : "0%", background: p.c }} /></div>
            </div>
          ))}
        </div>
      </div>
    </>
  );
}

// ─── LICENSES ─────────────────────────────────────────────────────────────────
function LicensesPage({ licenses, products, onRefresh, userId }: { licenses: License[]; products: Product[]; onRefresh: () => void; userId: string }) {
  const [search, setSearch] = useState("");
  const [filter, setFilter] = useState("all");
  const [showNew, setShowNew] = useState(false);
  const [wizard, setWizard]  = useState<License | null>(null);
  const [detail, setDetail]  = useState<License | null>(null);

  const filtered = licenses.filter(l => {
    const q = search.toLowerCase();
    const m = !q || l.key.toLowerCase().includes(q) || (l.customer_email ?? "").toLowerCase().includes(q) || (l.customer_name ?? "").toLowerCase().includes(q);
    const s = filter === "all" || l.status === filter;
    return m && s;
  });

  return (
    <>
      <div className="tbl-wrap">
        <div className="tbl-head">
          <span className="tbl-title">Licenses ({filtered.length})</span>
          <div style={{ display: "flex", gap: 7, alignItems: "center", flexWrap: "wrap" }}>
            <div className="search-wrap"><span className="search-ico">🔍</span><input placeholder="Key, email, name…" value={search} onChange={e => setSearch(e.target.value)} /></div>
            <select value={filter} onChange={e => setFilter(e.target.value)} style={{ width: "auto", padding: "6px 9px" }}>
              <option value="all">All</option><option value="active">Active</option><option value="trial">Trial</option><option value="expired">Expired</option><option value="suspended">Suspended</option>
            </select>
            <button className="btn btn-ghost btn-sm" onClick={onRefresh}>↻</button>
            <button className="btn btn-primary btn-sm" onClick={() => setShowNew(true)}>+ New</button>
          </div>
        </div>
        <table>
          <thead><tr><th>Key</th><th>Customer</th><th>Product</th><th>Status</th><th>Activations</th><th>Expires</th><th>Actions</th></tr></thead>
          <tbody>
            {filtered.map(l => {
              const prod = products.find(p => p.id === l.product_id);
              const expd = isExpired(l.expires_at);
              return (
                <tr key={l.id}>
                  <td><span className="key-mono">{l.key}</span></td>
                  <td><div style={{ fontSize: 12 }}>{l.customer_name ?? "—"}</div><div style={{ fontSize: 10.5, color: "var(--mu)" }}>{l.customer_email ?? ""}</div></td>
                  <td><span className="chip">{prod?.name ?? "—"}</span></td>
                  <td><Badge status={expd && l.status === "active" ? "expired" : l.status} /></td>
                  <td>
                    <div style={{ fontFamily: "var(--mono)", fontSize: 11.5 }}>{l.activations}/{l.max_activations}</div>
                    <div className="prog" style={{ width: 54 }}><div className="prog-fill" style={{ width: `${Math.min(100, (l.activations / l.max_activations) * 100)}%`, background: l.activations >= l.max_activations ? "var(--red)" : "var(--a2)" }} /></div>
                  </td>
                  <td style={{ fontSize: 11.5, color: expd ? "var(--red)" : "var(--mu)" }}>{l.expires_at ? fmt(l.expires_at) : "Never"}</td>
                  <td><div className="row-actions">
                    <button className="btn btn-ghost btn-xs" onClick={() => setDetail(l)}>View</button>
                    <button className="btn btn-teal btn-xs" onClick={() => setWizard(l)}>⚙ Install</button>
                  </div></td>
                </tr>
              );
            })}
          </tbody>
        </table>
        {filtered.length === 0 && <div className="empty"><div className="empty-ico">🔑</div><div className="empty-ttl">No licenses</div><div>Create your first license above.</div></div>}
      </div>
      {showNew && <NewLicenseModal products={products} userId={userId} onClose={() => setShowNew(false)} onCreated={() => { setShowNew(false); onRefresh(); }} />}
      {wizard  && <AutoInstallWizard license={wizard} onClose={() => setWizard(null)} />}
      {detail  && <LicenseDetail license={detail} products={products} onClose={() => setDetail(null)} onRefresh={() => { setDetail(null); onRefresh(); }} />}
    </>
  );
}

interface NewLicenseModalProps { products: Product[]; userId: string; onClose: () => void; onCreated: () => void; }
function NewLicenseModal({ products, userId, onClose, onCreated }: NewLicenseModalProps) {
  const [f, setF] = useState({ product_id: products[0]?.id ?? "", customer_name: "", customer_email: "", allowed_domains: "", allowed_ips: "", max_activations: "1", expires_at: "", status: "active", notes: "" });
  const [loading, setL] = useState(false);
  const [err, setErr]   = useState("");

  const submit = async () => {
    setL(true); setErr("");
    try {
      await sb.insert("lh_licenses", {
        key: genKey(), owner_id: userId,
        product_id: f.product_id || null,
        customer_name: f.customer_name || null,
        customer_email: f.customer_email || null,
        allowed_domains: f.allowed_domains ? f.allowed_domains.split(",").map(s => s.trim()).filter(Boolean) : null,
        allowed_ips: f.allowed_ips ? f.allowed_ips.split(",").map(s => s.trim()).filter(Boolean) : null,
        max_activations: Number(f.max_activations) || 1,
        expires_at: f.expires_at || null, status: f.status, notes: f.notes || null,
      });
      onCreated();
    } catch (e: unknown) { setErr(e instanceof Error ? e.message : "Unknown error"); }
    setL(false);
  };

  return (
    <Modal onClose={onClose} lg>
      <div className="modal-title">Generate New License</div>
      <div className="modal-sub">Stored in Supabase — gdmknaditlpfjcplsygc.</div>
      {err && <div className="alert a-err">{err}</div>}
      <div className="fr">
        <div className="fg"><label>Product</label><select value={f.product_id} onChange={e => setF({ ...f, product_id: e.target.value })}><option value="">None</option>{products.map(p => <option key={p.id} value={p.id}>{p.name}</option>)}</select></div>
        <div className="fg"><label>Status</label><select value={f.status} onChange={e => setF({ ...f, status: e.target.value })}><option value="active">Active</option><option value="trial">Trial</option><option value="suspended">Suspended</option></select></div>
      </div>
      <div className="fr">
        <div className="fg"><label>Customer Name</label><input placeholder="Acme Corp" value={f.customer_name} onChange={e => setF({ ...f, customer_name: e.target.value })} /></div>
        <div className="fg"><label>Customer Email</label><input placeholder="billing@acme.com" value={f.customer_email} onChange={e => setF({ ...f, customer_email: e.target.value })} /></div>
      </div>
      <div className="fg"><label>Allowed Domains (comma-separated)</label><input placeholder="acme.com, app.acme.com" value={f.allowed_domains} onChange={e => setF({ ...f, allowed_domains: e.target.value })} /><div className="input-hint">Blank = any domain</div></div>
      <div className="fg"><label>Allowed IPs</label><input placeholder="1.2.3.4" value={f.allowed_ips} onChange={e => setF({ ...f, allowed_ips: e.target.value })} /></div>
      <div className="fr">
        <div className="fg"><label>Max Activations</label><input type="number" min={1} value={f.max_activations} onChange={e => setF({ ...f, max_activations: e.target.value })} /></div>
        <div className="fg"><label>Expiry Date</label><input type="date" value={f.expires_at} onChange={e => setF({ ...f, expires_at: e.target.value })} /></div>
      </div>
      <div className="fg"><label>Notes</label><textarea placeholder="Internal notes…" value={f.notes} onChange={e => setF({ ...f, notes: e.target.value })} /></div>
      <div className="modal-foot">
        <button className="btn btn-ghost" onClick={onClose}>Cancel</button>
        <button className="btn btn-primary" onClick={() => void submit()} disabled={loading}>{loading ? <Spin /> : "Generate License"}</button>
      </div>
    </Modal>
  );
}

interface LicenseDetailProps { license: License; products: Product[]; onClose: () => void; onRefresh: () => void; }
function LicenseDetail({ license: l, products, onClose, onRefresh }: LicenseDetailProps) {
  const [loading, setL] = useState(false);
  const prod = products.find(p => p.id === l.product_id);
  const setStatus = async (s: string) => { setL(true); await sb.update("lh_licenses", { status: s }, { id: l.id }); setL(false); onRefresh(); };

  return (
    <Modal onClose={onClose} lg>
      <div className="modal-title">License Detail</div>
      <div className="modal-sub"><span className="key-mono">{l.key}</span></div>
      <div className="grid2" style={{ marginBottom: 0 }}>
        <div>
          <div className="fg"><label>Customer</label><div>{l.customer_name ?? "—"}<br /><span style={{ color: "var(--mu)", fontSize: 11.5 }}>{l.customer_email ?? ""}</span></div></div>
          <div className="fg"><label>Product</label><div>{prod?.name ?? "—"}</div></div>
          <div className="fg"><label>Status</label><Badge status={l.status} /></div>
          <div className="fg"><label>Expires</label><div style={{ color: isExpired(l.expires_at) ? "var(--red)" : "var(--tx)" }}>{l.expires_at ? fmt(l.expires_at) : "Never"}</div></div>
        </div>
        <div>
          <div className="fg"><label>Activations</label><div style={{ fontFamily: "var(--mono)" }}>{l.activations} / {l.max_activations}</div></div>
          <div className="fg"><label>Allowed Domains</label><div>{l.allowed_domains?.length ? l.allowed_domains.map(d => <span key={d} className="tag">{d}</span>) : <span style={{ color: "var(--mu)", fontSize: 12 }}>Any</span>}</div></div>
          <div className="fg"><label>Allowed IPs</label><div>{l.allowed_ips?.length ? l.allowed_ips.map(ip => <span key={ip} className="chip">{ip}</span>) : <span style={{ color: "var(--mu)", fontSize: 12 }}>Any</span>}</div></div>
          <div className="fg"><label>Created</label><div style={{ fontSize: 12, color: "var(--mu)" }}>{fmt(l.created_at)}</div></div>
        </div>
      </div>
      {l.notes && <div className="fg"><label>Notes</label><div style={{ fontSize: 12, color: "var(--mu)" }}>{l.notes}</div></div>}
      <div className="modal-foot" style={{ justifyContent: "space-between" }}>
        <div style={{ display: "flex", gap: 5 }}>
          {l.status !== "active"    && <button className="btn btn-success btn-sm" onClick={() => void setStatus("active")}    disabled={loading}>Activate</button>}
          {l.status !== "suspended" && <button className="btn btn-danger  btn-sm" onClick={() => void setStatus("suspended")} disabled={loading}>Suspend</button>}
        </div>
        <button className="btn btn-ghost" onClick={onClose}>Close</button>
      </div>
    </Modal>
  );
}

// ─── AUTO-INSTALL WIZARD ──────────────────────────────────────────────────────
function AutoInstallWizard({ license, onClose }: { license: License; onClose: () => void }) {
  const [step, setStep]       = useState(0);
  const [fw, setFw]           = useState<Framework | null>(null);
  const [tab, setTab]         = useState("bash");
  const [simRunning, setSim]  = useState(false);
  const [simLogs, setSimLogs] = useState<SimLogLine[]>([]);
  const [simDone, setSimDone] = useState(false);
  const logRef = useRef<HTMLDivElement>(null);
  const steps  = ["Select Framework", "Auto-Install Script", "Done"];

  const runSimulation = async (framework: Framework) => {
    setSim(true); setSimDone(false); setSimLogs([]);
    const lines: SimLogLine[] = [
      { t: 0,   cls: "log-info", text: `🔑 LicenseHub — ${framework.name} Auto-Installer` },
