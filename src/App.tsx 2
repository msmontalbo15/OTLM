  const [restoring, setRest]  = useState(true);
  const [page, setPage]       = useState<PageId>("dashboard");
  const [licenses, setLic]    = useState<License[]>([]);
  const [products, setProd]   = useState<Product[]>([]);
  const [logs, setLogs]       = useState<ValidationLog[]>([]);
  const [loading, setLoad]    = useState(false);

  // Restore session on mount
  useEffect(() => {
    const ok = sb.restore();
    if (ok && sb._user) setUser(sb._user);
    setRest(false);
  }, []);

  // Auto-refresh token every 50 min
  useEffect(() => {
    if (!user) return;
    const id = setInterval(() => { void sb.refresh(); }, 50 * 60 * 1000);
    return () => clearInterval(id);
  }, [user]);

  const load = useCallback(async () => {
    if (!sb._token) return;
    setLoad(true);
    const [l, p, lg] = await Promise.all([
      sb.select<License>("lh_licenses", "select=*&order=created_at.desc"),
      sb.select<Product>("lh_products", "select=*&order=created_at.desc"),
      sb.select<ValidationLog>("lh_validation_logs", "select=*&order=created_at.desc&limit=300"),
    ]);
    setLic(l); setProd(p); setLogs(lg);
    setLoad(false);
  }, []);

  useEffect(() => { if (user) void load(); }, [user, load]);

  const logout = async () => { await sb.signOut(); setUser(null); setLic([]); setProd([]); setLogs([]); };

  if (restoring) return (
    <>
      <style>{css}</style>
      <div style={{ minHeight: "100vh", display: "flex", alignItems: "center", justifyContent: "center", background: "var(--bg)", color: "var(--mu)", fontFamily: "var(--sans)", flexDirection: "column", gap: 12 }}>
        <div className="logo-glyph" style={{ margin: "0 auto" }}>🔐</div>
        <div style={{ fontSize: 12, marginTop: 8 }}>Restoring session…</div>
      </div>
    </>
  );

  if (!user) return <><style>{css}</style><AuthPage onAuth={u => setUser(u)} /></>;

  const nav: { g: string; items: { id: PageId; l: string; i: string; count?: number }[] }[] = [
    { g: "Main",  items: [{ id: "dashboard", l: "Dashboard", i: "◈" }, { id: "licenses", l: "Licenses", i: "🔑", count: licenses.filter(x => x.status === "active").length }, { id: "products", l: "Products", i: "📦" }] },
    { g: "Tools", items: [{ id: "validate", l: "Validate", i: "✓" }, { id: "analytics", l: "Analytics", i: "📊" }, { id: "wizard", l: "SDK Wizard", i: "⚙" }] },
    { g: "Setup", items: [{ id: "api", l: "API Docs", i: "📡" }, { id: "database", l: "DB Schema", i: "🗄️" }] },
  ];

  const renderPage = () => {
    if (loading) return <div className="lc"><Spin /><span>Loading from Supabase…</span></div>;
    switch (page) {
      case "dashboard":  return <Dashboard licenses={licenses} logs={logs} />;
      case "licenses":   return <LicensesPage licenses={licenses} products={products} onRefresh={load} userId={user.id} />;
      case "products":   return <ProductsPage products={products} onRefresh={load} userId={user.id} />;
      case "validate":   return <ValidatePage />;
      case "analytics":  return <AnalyticsPage logs={logs} />;
      case "wizard":     return <WizardPage />;
      case "api":        return <ApiDocsPage />;
      case "database":   return <DatabasePage />;
    }
  };

  return (
    <>
      <style>{css}</style>
      <div className="shell">
        <div className="sidebar">
          <div className="logo"><div className="logo-glyph">🔐</div><div><div className="logo-name">LicenseHub</div><div className="logo-tag">SaaS Manager</div></div></div>
          <nav className="nav">
            {nav.map(g => (
              <div key={g.g} className="nav-group">
                <div className="nav-lbl">{g.g}</div>
                {g.items.map(item => (
                  <button key={item.id} className={`nav-btn ${page === item.id ? "on" : ""}`} onClick={() => setPage(item.id)}>
                    <span className="ico">{item.i}</span>{item.l}
                    {(item.count ?? 0) > 0 && <span className="nb-count">{item.count}</span>}
                  </button>
                ))}
              </div>
            ))}
          </nav>
          <div className="sb-foot">
            <div className="sb-user">{user.email}</div>
            <div><span className="dot dot-on" />gdmknaditlpfjcplsygc</div>
            <button className="btn btn-ghost btn-xs" style={{ marginTop: 5 }} onClick={() => void logout()}>Sign Out</button>
          </div>
        </div>
        <div className="main">
          <div className="topbar">
            <span className="topbar-title">{PAGE_TITLES[page]}</span>
            <div className="topbar-right">
              <button className="btn btn-ghost btn-sm" onClick={() => void load()} disabled={loading}>↻ Refresh</button>
              <button className="btn btn-primary btn-sm" onClick={() => setPage("licenses")}>+ New License</button>
            </div>
          </div>
          <div className="content">{renderPage()}</div>
        </div>
      </div>
    </>
  );
}