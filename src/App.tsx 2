function ApiDocsPage() {
  return (
    <div style={{ maxWidth: 720 }}>
      <div className="alert a-info" style={{ marginBottom: 16 }}>
        <span>📡</span>
        <div><strong>Supabase REST API</strong> — Base: <code style={{ fontFamily: "var(--mono)", fontSize: 11, color: "var(--a2)" }}>https://gdmknaditlpfjcplsygc.supabase.co</code></div>
      </div>
      <Code lang="typescript" code={`const SB  = "https://gdmknaditlpfjcplsygc.supabase.co";
const KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...";
const LIC = "YOUR_LICENSE_KEY";
const H   = { apikey: KEY, Authorization: \`Bearer \${KEY}\`, "Content-Type": "application/json" };

async function validate(domain: string, framework: string) {
  const [lic] = await fetch(\`\${SB}/rest/v1/lh_licenses?key=eq.\${LIC}\`, { headers: H }).then(r => r.json());
  const result = !lic ? "invalid"
    : lic.status === "suspended" ? "suspended"
    : lic.status === "expired" || (lic.expires_at && new Date(lic.expires_at) < new Date()) ? "expired"
